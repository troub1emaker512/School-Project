<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>

   <!-- Responsive Meta Tag -->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Custom styles -->
  <link href="/main.css" rel="stylesheet">
</head>
<body class="bg-light">

  <!-- Main container for homepage content -->
  <div class="container text-center py-5">

    <!-- Dynamic site title set via site settings -->
    <h1 class="mb-3"><%= title %></h1>

    <!-- Dynamic site description set via site settings -->
    <p class="lead mb-5"><%= description %></p>

     <!-- User role selection prompt -->
    <h2 class="mb-4">Who are you?</h2>

    <!-- Buttons leading to either organiser or attendee routes -->
    <div class="row justify-content-center">

      <!-- Organiser button (redirects to login if not authenticated) -->
      <div class="col-md-5 mb-3">
        <a href="/organiser/login" class="d-block role-button organiser-btn text-decoration-none">
          Organiser
        </a>
      </div>

      <!-- Attendee button (redirects to public attendee view) -->
      <div class="col-md-5 mb-3">
        <a href="/attendee" class="d-block role-button attendee-btn text-decoration-none">
          Attendee
        </a>
      </div>
    </div>
  </div>
</body>
</html>