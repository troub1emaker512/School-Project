<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Access Denied</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/main.css">
</head>

<!-- Session conflict page shown if both attendee and organiser sessions are active -->
<!-- Prompts the user to logout and continue as the intended role -->
<body class="bg-light">
  
  <!-- Styled box with conflict message and links -->
  <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg text-center p-5" style="max-width: 600px; width: 100%;">
      <h3 class="text-danger mb-3">Access Denied</h3>
      <p class="mb-4">
        You are currently logged in as a different user type.<br>
        Please use the appropriate homepage to log out before accessing this section.
      </p>
      <a href="/" class="btn btn-soft-red custom-red-text w-50 mx-auto">Back to Home</a>
    </div>
  </div>
</body>
</html>
