<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Attendee Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="attendee-card">
      <h2 class="text-soft-blue mb-4">Register</h2>

      <!-- Register form for attendees -->
      <form method="POST" action="/attendee/register">

        <!-- Name input -->
        <div class="mb-3">
          <label>Name</label>
          <input type="text" name="name" class="form-control" required>
        </div>

        <!-- Email input -->
        <div class="mb-3">
          <label>Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>

        <!-- Password input -->
        <div class="mb-4">
          <label>Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>

        <!-- Navigation buttons: back to login / register -->
        <div class="d-flex justify-content-between">
            <a href="/attendee/login" class="btn btn-soft-red">Back</a>
            <button class="btn btn-themed">Register</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
