<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="text-soft-blue mb-1"><%= title %></h1>
    <p class="mb-4 text-muted"><%= description %></p>

    <h2 class="section-heading">Upcoming Events</h2>

    <% if (events.length > 0) { %>
      <% events.forEach(event => { %>
        <div class="organiser-card">
        <h5><%= event.title %></h5>
        <p>
            <strong>Date:</strong> <%= event.date %><br>
            <strong>Description:</strong> <%= event.description %><br>

            <strong>Full Tickets:</strong>
            <% if (event.full_remaining > 0) { %>
                <span class="badge bg-secondary"><%= event.full_remaining %> left</span>
            <% } else { %>
                <span class="badge bg-danger">Sold Out</span>
            <% } %><br>

            <strong>Concession Tickets:</strong>
            <% if (event.concession_remaining > 0) { %>
                <span class="badge bg-secondary"><%= event.concession_remaining %> left</span>
            <% } else { %>
                <span class="badge bg-danger">Sold Out</span>
            <% } %>

            <% if (event.total_remaining === 0) { %>
                <p class="text-danger fw-bold mt-2 mb-0">All tickets for this event are sold out.</p>
            <% } %>
        </p>
        <% if (event.total_remaining > 0) { %>
          <a href="/attendee/event/<%= event.id %>" class="btn btn-outline-primary btn-sm">View & Book</a>
        <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <p>No upcoming events at the moment.</p>
    <% } %>
    <hr class="my-5">

    <% if (!isLoggedIn) { %>
  <h2 class="section-heading text-center">Already have an account?</h2>
  <p class="text-center text-muted">Log in or register to manage your bookings and see your personalised dashboard.</p>

  <div class="d-flex justify-content-center gap-3 mt-3 mb-4">
    <a href="/attendee/login" class="btn btn-soft px-4">Log In</a>
    <a href="/attendee/register" class="btn btn-soft px-4">Register</a>
  </div>
  <% } else { %>
    <h2 class="section-heading text-center">Welcome back, <%= userName %>!</h2>
    <p class="text-center text-muted">Access your personalised bookings dashboard or logout below.</p>

    <div class="d-flex justify-content-center gap-3 mt-3 mb-4">
      <a href="/attendee/dashboard" class="btn btn-themed px-4">My Dashboard</a>
      <a href="/attendee/logout" class="btn btn-soft-red px-4">Logout</a>
    </div>
  <% } %>
  <a href="/" class="btn btn-soft">Back to Main Homepage</a>
  </div>
</body>
</html>