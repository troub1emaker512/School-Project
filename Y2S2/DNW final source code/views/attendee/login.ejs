<!-- Page for attendee login form -->
<!-- Uses POST method to send credentials to /attendee/login -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Attendee Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/main.css"> 
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="attendee-card">
      <h2 class="text-soft-blue mb-4">Login</h2>
      <!-- Container for the login form -->
      <form method="POST" action="/attendee/login">
        <!-- Email input field -->
        <div class="mb-3">
          <label>Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <!-- Password input field -->
        <div class="mb-4">
          <label>Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <!-- Back to homepage / Submit login -->
        <div class="d-flex justify-content-between">
          <a href="/attendee" class="btn btn-soft-red">Back</a>
          <button class="btn btn-themed">Login</button>
        </div>
        <hr class="my-4">
         <!-- Option for users who don't have an account -->
        <p class="text-muted text-center mb-1">Don't have an account?</p>
        <div class="text-center">
          <a href="/attendee/register" class="btn btn-soft-red px-4">Register Here</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
