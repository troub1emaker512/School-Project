<!--
  Edit/Create Event Page
  Used for both creating a new event or editing an existing one
  Pre-fills fields if editing
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Event</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-3 text-soft-blue">Edit Event</h1>
    <p class="text-muted mb-4">Created on: <%= event.created_at %></p>

    <form action="/organiser/event/<%= event.id %>" method="POST" class="bg-white p-4 rounded shadow organiser-card">

      <!-- Event name input -->
      <div class="mb-3">
        <label for="title" class="form-label">Event Title</label>
        <input type="text" name="title" id="title" class="form-control" value="<%= event.title %>" required>
      </div>

      <!-- Description text area -->
      <div class="mb-3">
        <label for="description" class="form-label">Event Description</label>
        <textarea name="description" id="description" class="form-control" rows="3" required><%= event.description %></textarea>
      </div>

      <!-- Date picker -->
      <div class="mb-3">
        <label for="date" class="form-label">Event Date</label>
        <input type="date" name="date" id="date" class="form-control" value="<%= event.date %>" required>
      </div>
      
      <!-- Price inputs -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="full_price" class="form-label">Full Ticket Price ($)</label>
          <input type="number" name="full_price" id="full_price" class="form-control" value="<%= event.full_price || 0 %>" step="0.01" required>
        </div>

        <!-- Ticket count inputs -->
        <div class="col-md-6 mb-3">
          <label for="full_quantity" class="form-label">Full Ticket Quantity</label>
          <input type="number" name="full_quantity" id="full_quantity" class="form-control" value="<%= event.full_quantity || 0 %>" required>
        </div>

        <!-- Price inputs -->
        <div class="col-md-6 mb-3">
          <label for="concession_price" class="form-label">Concession Ticket Price ($)</label>
          <input type="number" name="concession_price" id="concession_price" class="form-control" value="<%= event.concession_price || 0 %>" step="0.01" required>
        </div>

        <!-- Ticket count inputs -->
        <div class="col-md-6 mb-3">
          <label for="concession_quantity" class="form-label">Concession Ticket Quantity</label>
          <input type="number" name="concession_quantity" id="concession_quantity" class="form-control" value="<%= event.concession_quantity || 0 %>" required>
        </div>
      </div>

      <!-- Submit event changes or return to dashboard -->
      <div class="d-flex justify-content-between mt-4">
        <a href="/organiser" class="btn btn-outline-secondary">Back to Dashboard</a>
        <button type="submit" class="btn btn-success">Save Changes</button>
      </div>
    </form>
  </div>
</body>
</html>
