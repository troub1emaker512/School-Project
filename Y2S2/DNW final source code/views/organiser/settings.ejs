<!--
  Site Settings Page
  Allows the organiser to update the homepage title and description.
  Pre-fills form with current values from the settings object.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Site Settings</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-4 text-soft-blue">Site Settings</h1>

    <!-- Form to update site name and description -->
    <form action="/organiser/settings" method="POST" class="bg-white p-4 rounded shadow organiser-card">

      <!-- Input for site name -->
      <div class="mb-3">
        <label for="name" class="form-label">Site Name</label>
        <input type="text" id="name" name="name" class="form-control" value="<%= settings.name %>" required>
      </div>

      <!-- Textarea for site description -->
      <div class="mb-3">
        <label for="description" class="form-label">Site Description</label>
        <textarea id="description" name="description" class="form-control" rows="3" required><%= settings.description %></textarea>
      </div>

      <!-- Save settings or go back to organiser homepage -->
      <div class="d-flex justify-content-between mt-4">
        <a href="/organiser" class="btn btn-outline-secondary">Back</a>
        <button type="submit" class="btn btn-primary">Save Settings</button>
      </div>
    </form>
  </div>
</body>
</html>
