<!--
  Organiser Login Page
  Displays a form for organisers to log in.
  If login fails, shows an error alert.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Organiser Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/main.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="organiser-card">
          <h2 class="text-center mb-4">Organiser Login</h2>

          <!-- Display error message if login fails -->
          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <!-- Organiser login form POSTs to /organiser/login -->
          <form action="/organiser/login" method="POST">

            <!-- Username field -->
            <div class="mb-3">
              <label class="form-label">Username</label>
              <input type="text" name="username" class="form-control" required>
            </div>

            <!-- Password field -->
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input type="password" name="password" class="form-control" required>
            </div>
            
            <!-- Submit login form -->
            <button type="submit" class="btn btn-soft w-100">Login</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
