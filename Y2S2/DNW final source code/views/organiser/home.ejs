<!--
  Organiser Dashboard
  Displays list of draft and published events
  Allows managing, publishing, or deleting events
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-1"><%= title %></h1>
    <p class="mb-4 text-muted"><%= description %></p>

    <div class="mb-4">
      <a href="/organiser/settings" class="btn btn-outline-secondary me-2">Edit Site Settings</a>
      <a href="/organiser/bookings" class="btn btn-outline-info">View Bookings</a>
      <a href="/organiser/create" class="btn btn-primary">+ Create New Event</a>
      <a href="/organiser/logout" class="btn btn-danger">Logout</a>
    </div>

    <!-- Display published events -->
    <h2 class="section-heading">Published Events</h2>
    <% if (publishedEvents.length > 0) { %>
      <% publishedEvents.forEach(event => { %>
        <div class="organiser-card">
          <h5><%= event.title %></h5>
          <p class="mb-1">
            <strong>Date:</strong> <%= event.date %><br>
            <strong>Description:</strong> <%= event.description %><br>

            <strong>Full Tickets:</strong> $<%= parseFloat(event.full_price).toFixed(2) %> × <%= event.full_quantity %>
            <% if (event.full_remaining > 0) { %>
              <span class="badge bg-secondary ms-2"><%= event.full_remaining %> left</span>
            <% } else { %>
              <span class="badge bg-danger ms-2">Sold Out</span>
            <% } %><br>

            <strong>Concession Tickets:</strong> $<%= parseFloat(event.concession_price).toFixed(2) %> × <%= event.concession_quantity %>
            <% if (event.concession_remaining > 0) { %>
              <span class="badge bg-secondary ms-2"><%= event.concession_remaining %> left</span>
            <% } else { %>
              <span class="badge bg-danger ms-2">Sold Out</span>
            <% } %>

            <% if (event.total_remaining === 0) { %>
              <p class="text-danger fw-bold mt-2 mb-0">All tickets for this event are sold out.</p>
            <% } %>
          </p>
          <div class="d-flex justify-content-between flex-wrap align-items-center">
            <div class="btn-group mt-2 mt-md-0">
              <form action="/organiser/delete/<%= event.id %>" method="POST" style="display:inline;">
                <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this event?')">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No published events.</p>
    <% } %>

    <!-- Display draft events -->
    <h2 class="section-heading">Draft Events</h2>
    <% if (draftEvents.length > 0) { %>
      <% draftEvents.forEach(event => { %>
        <div class="organiser-card">
          <h5><%= event.title %></h5>
          <p class="mb-1">
            <strong>Date:</strong> <%= event.date %><br>
            <strong>Description:</strong> <%= event.description %><br>
            <strong>Full Tickets:</strong> $<%= parseFloat(event.full_price).toFixed(2) %> × <%= event.full_quantity %><br>
            <strong>Concession Tickets:</strong> $<%= parseFloat(event.concession_price).toFixed(2) %> × <%= event.concession_quantity %>
          </p>

          <!-- Edit event -->
          <div class="d-flex justify-content-between flex-wrap align-items-center">
            <a href="/organiser/event/<%= event.id %>" class="btn btn-sm btn-outline-primary">Edit</a>

            <!-- Publish event -->
            <div class="btn-group mt-2 mt-md-0">
              <form action="/organiser/publish/<%= event.id %>" method="POST" style="display:inline;">
                <button class="btn btn-sm btn-success">Publish</button>
              </form>
              
              <!-- Delete event -->
              <form action="/organiser/delete/<%= event.id %>" method="POST" style="display:inline;">
                <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this event?')">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No draft events.</p>
    <% } %>
  </div>
</body>
</html>
