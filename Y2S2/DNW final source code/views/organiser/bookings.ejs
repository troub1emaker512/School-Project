<!--
  Bookings Page
  Shows list of users who booked a specific event
  Accessible by the organiser
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Event Bookings</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/main.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="text-soft-blue mb-4">Event Bookings</h1>

    <!-- Iterate over each booking and display user info -->
    <% if (bookings.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Attendee</th>
              <th>Event</th>
              <th>Full Tickets</th>
              <th>Concession Tickets</th>
              <th>Booked At</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(b => { %>
              <tr>
                <td><%= b.attendee_name %></td>
                <td><%= b.event_title %></td>
                <td><%= b.full_tickets %></td>
                <td><%= b.concession_tickets %></td>
                <td><%= b.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p>No bookings yet.</p>
    <% } %>

    <!-- Return to organiser dashboard -->
    <a href="/organiser" class="btn btn-outline-secondary mt-4">Back to Dashboard</a>
  </div>
</body>
</html>
